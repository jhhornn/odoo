# Odoo Connection Settings
ODOO_URL=https://your-instance.odoo.com
ODOO_DATABASE=production
ODOO_USERNAME=admin
ODOO_PASSWORD=secure_password

# Application Settings
PORT=3000
NODE_ENV=development

# API Key Authentication (all routes require X-API-Key header)
# List calling services (comma-separated), then define per-service vars.
SYNC_SERVICES=octohealth,octodoc

# Octohealth
OCTOHEALTH_API_KEY=octohealth-secret-key-here
OCTOHEALTH_COMPANY_ID=1
OCTOHEALTH_WEBHOOK_URL=
OCTOHEALTH_WEBHOOK_TOKEN=

# Octodoc
OCTODOC_API_KEY=octodoc-secret-key-here
OCTODOC_COMPANY_ID=1
OCTODOC_WEBHOOK_URL=
OCTODOC_WEBHOOK_TOKEN=