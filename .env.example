# Odoo Connection Settings
ODOO_URL=https://your-instance.odoo.com
ODOO_DATABASE=production
ODOO_USERNAME=admin
ODOO_PASSWORD=secure_password

# Application Settings
PORT=3000
NODE_ENV=development

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/odoo_sync?schema=public

# Redis
REDIS_URL=redis://redis:6379

# Webhook signing-secret encryption (long random string)
APP_SECRET=change-me-to-a-long-random-string

# Optional: restrict generic /odoo/* routes (comma-separated)
# ODOO_API_ALLOWED_MODELS=res.partner,product.product
